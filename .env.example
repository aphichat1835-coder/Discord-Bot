# =========================================================
# Phomueangtai Enterprise Discord Bot — Environment Example
# =========================================================
# Copy only the values needed for each Render service.
# Never commit real secrets or tokens.

# -------------------------
# Shared
# -------------------------
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/phomueangtai
ENCRYPTION_KEY=change-me-to-a-long-random-secret-32-bytes-or-more
API_SECRET=change-me-to-a-long-random-internal-secret
NODE_ENV=production

# -------------------------
# Service 1: Main Bot + Owner Dashboard
# Root Directory: repository root
# Build Command: npm install
# Start Command: npm start
# -------------------------
TOKEN_MANAGER=YOUR_DISCORD_BOT_TOKEN
PORT=3000
DASHBOARD_PIN=change-me-owner-dashboard-pin
DASHBOARD_URL=https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com
WEBHOOK_LOG_URL=
ALERT_WEBHOOK_URL=
SHADOW_MASTER_ID=

# -------------------------
# Service 2: Dashboard 3 / Public Verification Dashboard
# Root Directory: dashboard-public
# Build Command: npm install
# Start Command: npm start
# -------------------------
# Render normally injects PORT automatically. Do not hardcode it.
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_CLIENT_SECRET
TOKEN_MANAGER=YOUR_DISCORD_BOT_TOKEN
SESSION_SECRET=change-me-session-secret
DASHBOARD_URL=https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com
INTERNAL_API_SECRET=change-me-to-same-or-separate-internal-secret

# Discord Developer Portal OAuth2 Redirect URIs required:
# https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com/auth/callback
# https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com/auth/admin-callback
