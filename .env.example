# =========================================================
# Phomueangtai Personal Multi-Tool Discord Bot - Environment Example
# =========================================================
# Placeholder reference only. Do not commit real secrets, tokens,
# webhook URLs, MongoDB URLs, dashboard PINs, OAuth secrets, or API keys.
#
# The repository has one Node.js runtime and one public HTTP port.
# Render injects PORT automatically.
# Runtime is pinned to Node.js 24 in package engines and render.yaml.

# =========================================================
# Unified runtime
# =========================================================

# Required
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/phomueangtai
TOKEN_MANAGER=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-application-client-secret
ENCRYPTION_KEY=replace-with-random-secret-at-least-32-bytes

# Required by Owner Dashboard authentication/signing
API_SECRET=replace-with-random-api-secret

# Required in production for signed verification state.
VERIFY_STATE_SECRET=replace-with-random-verify-state-secret

# Local-only port. Render/inwcloud normally supplies PORT.
# PORT=3000

# =========================================================
# Bot + voice/session + Owner Dashboard + verification
# Root directory: .
# Start command: npm start
# =========================================================

# Required for owner dashboard login
DASHBOARD_PIN=replace-with-owner-dashboard-pin
DASHBOARD_SESSION_MAX_AGE_MS=86400000
DASHBOARD_SESSION_REFRESH_AFTER_MS=1800000

# One public origin used by Owner Dashboard and OAuth callbacks.
# Keep aliases equal while compatibility paths still accept the legacy names.
DASHBOARD_URL=https://your-one-runtime.example.com
PUBLIC_DASHBOARD_URL=https://your-one-runtime.example.com
PUBLIC_BASE_URL=https://your-one-runtime.example.com
DASHBOARD_PUBLIC_URL=https://your-one-runtime.example.com

# Optional host-provided external URL used in alerts/links
RENDER_EXTERNAL_URL=https://your-one-runtime.onrender.com

# Required only when running scripts/smokeUnifiedRuntime.js.
# Comma-separated exact hostnames; do not include protocol, path, or wildcard.
SMOKE_ALLOWED_HOSTS=your-one-runtime.example.com,your-one-runtime.onrender.com

# Optional owner/master Discord user ID. If unset, config.json ownerId is used.
SHADOW_MASTER_ID=replace-with-owner-discord-user-id

# Optional Discord webhook URLs. Use real values only in the host environment.
WEBHOOK_LOG_URL=https://discord-webhook-placeholder.invalid/logs
ALERT_WEBHOOK_URL=https://discord-webhook-placeholder.invalid/alerts

# Optional owner Join Authorized Users controls. Non-secret guild IDs only.
# Default enabled. Leave JOIN_CAMPAIGN_ALLOWED_GUILDS empty to allow every guild
# currently cached by the bot, or set explicit target guild IDs to restrict it.
JOIN_CAMPAIGN_ENABLED=true
JOIN_CAMPAIGN_ALLOWED_GUILDS=
JOIN_CAMPAIGN_MAX_USERS=5000
JOIN_CAMPAIGN_DELAY_MS=1500
JOIN_CAMPAIGN_PROGRESS_EVERY=50
JOIN_CAMPAIGN_REFRESH_MARGIN_MS=3600000

# Optional owner/system guard controls. Non-secret IDs only.
TRACE_ERASER_DEFAULT_POLICY=approval
TRACE_ERASER_GUILD_POLICY=
TRACE_ERASER_BLOCKED_GUILDS=
TRACE_ERASER_APPROVAL_GUILDS=
TRACE_ERASER_ALLOWED_GUILDS=
TRACE_ERASER_PROTECTED_CHANNEL_IDS=
SHADOW_PROTECTED_CHANNEL_IDS=
TRACE_ERASER_DRY_RUN=false
TRACE_ERASER_KILL_SWITCH=false
TRACE_ERASER_RATE_LIMIT_MAX=5
TRACE_ERASER_RATE_LIMIT_WINDOW_MS=600000

# Optional debug flag for multi-client voice behavior
VOICE_DEBUG_MULTI_CLIENT=false

# Service 1 bounded load/runtime controls
SESSION_LOAD_MAX=100
APPROVED_GUILDS_LOAD_MAX=1000
PENDING_GUILDS_LOAD_MAX=500
WHITELIST_LOAD_MAX=1000
BOT_SETTINGS_LOAD_MAX=500
PANEL_STATES_LOAD_MAX=500
RATE_LIMIT_MAX_BUCKETS=5000
COMMAND_COOLDOWN_MAX_USERS=5000
TOGGLE_COOLDOWN_MAX_KEYS=1000
ANTI_RAID_DEBOUNCE_MAX_KEYS=5000
PIN_ATTEMPT_MAX_KEYS=1000
ROTATE_MESSAGES_MAX=20
SAY_USAGE_MAX_USERS=5000

# Default true: store encrypted OAuth refresh tokens so Discord OAuth authorization can be refreshed.
STORE_OAUTH_TOKENS=true
OAUTH_TOKEN_REFRESH_MARGIN_MS=86400000
OAUTH_TOKEN_REFRESH_SCAN_LIMIT=100
OAUTH_TOKEN_REFRESH_FAIL_MAX=5

# Automatically archive and migrate only legacy OAuthUser documents after MongoDB connects.
# Archives are hash-deduplicated rollback copies inside the same MongoDB database.
AUTO_VERIFICATION_MIGRATION=true
AUTO_VERIFICATION_MIGRATION_SCAN_MAX=200
VERIFICATION_MIGRATION_BATCH_SIZE=100
OAUTH_USER_SUMMARY_MAX=100
# Optional: exact historical redirect URI used when old adminOAuth grants were issued.
# No new admin OAuth grants are created by the unified runtime.
# LEGACY_ADMIN_OAUTH_REDIRECT_URI=https://old-dashboard.example.com/auth/admin-callback

# Render is behind a trusted proxy. For other hosts, enable only when you trust it.
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Default false. Enable only when the app is behind real, trusted Cloudflare forwarding.
# If enabled on a public origin that accepts direct traffic, clients can spoof this header.
ENABLE_CF_IP_HEADER=false

# External IP lookup controls.
# Keep enabled only when your deployment policy allows sending client IPs to a lookup provider.
IP_LOOKUP_ENABLED=true
IP_LOOKUP_API_BASE_URL=https://ip-api.com/json
IP_LOOKUP_CACHE_MAX=5000
IP_LOOKUP_CACHE_TTL_MS=600000
IP_LOOKUP_CIRCUIT_FAIL_THRESHOLD=10
IP_LOOKUP_CIRCUIT_OPEN_MS=300000
IP_LOOKUP_RESPONSE_MAX_BYTES=262144
IP_LINK_USERS_MAX=200
IP_LINK_DEVICE_FINGERPRINTS_MAX=30
IP_LINK_ROLE_SNAPSHOTS_MAX=80
DEVICE_DUPLICATE_LOOKUP_MAX=200

# Verification Discord API and internal scan caps
DISCORD_API_RESPONSE_MAX_BYTES=12582912
DISCORD_API_BODY_MAX_BYTES=524288
DISCORD_API_ROLE_MAX=500
DISCORD_API_CHANNEL_MAX=500
DISCORD_API_PERMISSION_OVERWRITE_MAX=100
INTERNAL_OVERVIEW_GUILDS_MAX=500
OAUTH_SNAPSHOT_CHUNK_MAX_BYTES=524288
OAUTH_SNAPSHOT_CHUNK_MAX_ITEMS=100
OAUTH_SNAPSHOT_CLEANUP_GRACE_HOURS=24
OAUTH_SNAPSHOT_CLEANUP_SCAN_MAX=200
RETENTION_CONFIG_SCAN_MAX=1000
RETENTION_ERROR_MAX=50
VERIFIED_MEMBER_SCAN_MAX=5000
VERIFICATION_SNAPSHOT_MAX_BYTES=12582912
SENSITIVE_ACCESS_LOG_MAX=100
SENSITIVE_REVEAL_BUCKET_MAX=10000

# Verification static asset cache policy
STATIC_CACHE_MAX_AGE=10m

# Main bot memory monitor controls
MEMORY_WARN_MB=180
MEMORY_CRITICAL_MB=220
MEMORY_CRITICAL_ROUNDS=3
MEMORY_TREND_MAX=24
# cleanup_only keeps the process alive after emergency cleanup; graceful_exit exits after saving state.
MEMORY_CRITICAL_MODE=graceful_exit

# Optional thresholds for `npm run check:memory-trend`.
MEMORY_TREND_HEAP_GROWTH_MB=40
MEMORY_TREND_RSS_GROWTH_MB=80
MEMORY_TREND_LISTENER_GROWTH=5
MEMORY_TREND_HANDLE_GROWTH=20
MEMORY_TREND_CACHE_GROWTH=500

# Voice worker runtime limits
VOICE_LOG_MAX=200
VOICE_LEAN_MODE=true
VOICE_LEAN_KEEP_TARGET_GUILD=true
VOICE_LEAN_CLEANUP_INTERVAL_MS=60000
VOICE_LEAN_LOG=false
VOICE_SELF_MESSAGE_CACHE_MAX=25
VOICE_SELF_MEMBER_CACHE_MAX=50
VOICE_SELF_USER_CACHE_MAX=100
VOICE_SELF_CACHE_CLEANUP_TTL_MS=300000
DISCORD_MESSAGE_CACHE_MAX=100
DISCORD_MESSAGE_SWEEP_INTERVAL_SEC=300
DISCORD_MESSAGE_SWEEP_LIFETIME_SEC=900
SPAM_TRACKING_CLEANUP_MS=60000
SPAM_TRACKING_ENTRY_TTL_MS=300000

# Audit logger safety controls
AUDIT_MAX_QUEUE_PER_GUILD=200
LOG_CORE_MAX_QUEUE_PER_GUILD=250
AUDIT_CIRCUIT_FAILURES=5
AUDIT_CIRCUIT_OPEN_MS=60000
AUDIT_DUPLICATE_TTL_MS=60000
AUDIT_DEDUP_TTL_MS=600000
AUDIT_DEDUP_MAX_KEYS=5000
AUDIT_HELPER_CACHE_MAX=500
AUDIT_HELPER_MAX_AGE_MS=15000
AUDIT_HELPER_DELAY_MS=650
MESSAGE_SNAPSHOT_CACHE_MAX=1000
MESSAGE_SNAPSHOT_CACHE_TTL_MS=3600000
AUDIT_LOG_MESSAGE_CREATE=false
AUDIT_RECONCILER_ENABLED=false
AUDIT_RECONCILER_INTERVAL_MS=300000
AUDIT_RECONCILER_LIMIT=10
AUDIT_RETENTION_DAYS=90
AUDIT_LOG_DELETED_MESSAGE_CONTENT=true
AUDIT_LOG_EDITED_MESSAGE_CONTENT=true
AUDIT_REDACT_LINKS=false
AUDIT_REDACT_MENTIONS=false
AUDIT_MAX_CONTENT_LENGTH=800

# Feature flags. Set to false only when intentionally disabling a subsystem.
FEATURE_VOICE=true
FEATURE_VERIFICATION=true
FEATURE_AUDIT=true
FEATURE_PROTECTION=true
FEATURE_BACKUP=true
FEATURE_ROLE_BUTTON=true
FEATURE_SENSITIVE_ACCESS=true
FEATURE_MEMORY_MONITOR=true

# =========================================================
# Discord Developer Portal Redirect URI
# =========================================================
# https://your-one-runtime.example.com/auth/callback
