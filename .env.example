# =========================================================
# Phomueangtai Personal Multi-Tool Discord Bot - Environment Example
# =========================================================
# Placeholder reference only. Do not commit real secrets, tokens,
# webhook URLs, MongoDB URLs, dashboard PINs, OAuth secrets, or API keys.
#
# The repository has two Node.js services. Render injects PORT automatically.
# For local development, copy only the variables needed by the service you run.

# =========================================================
# Shared by Service 1 and Service 2
# =========================================================

# Required
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/phomueangtai
TOKEN_MANAGER=replace-with-discord-bot-token
ENCRYPTION_KEY=replace-with-random-secret-at-least-32-bytes

# Required by Service 1 and accepted by Service 2 internal APIs
API_SECRET=replace-with-random-api-secret

# Required/recommended when Service 1 calls Dashboard Public internal APIs
INTERNAL_API_SECRET=replace-with-random-internal-api-secret

# Recommended for signed verification state. Falls back to other secrets if absent.
VERIFY_STATE_SECRET=replace-with-random-verify-state-secret

# Local-only port examples. Render supplies PORT, so normally leave these unset there.
# Service 1 default: 3000
# Service 2 default: 3001
# PORT=3000
# PORT_DASHBOARD=3001

# Compatibility bot-token fallback names used by Dashboard Public.
# Prefer TOKEN_MANAGER unless an older host already uses one of these names.
# BOT_TOKEN=replace-with-discord-bot-token
# DISCORD_BOT_TOKEN=replace-with-discord-bot-token
# TOKEN=replace-with-discord-bot-token

# =========================================================
# Service 1 - Main Discord Bot / Owner Dashboard
# Root directory: .
# Start command: npm start
# =========================================================

# Required for owner dashboard login
DASHBOARD_PIN=replace-with-owner-dashboard-pin

# Dashboard Public URL used by setup flows, OAuth callbacks, and owner verification views.
# These aliases are accepted by different compatibility paths in the code.
DASHBOARD_URL=https://your-dashboard-public-service.onrender.com
PUBLIC_DASHBOARD_URL=https://your-dashboard-public-service.onrender.com
PUBLIC_BASE_URL=https://your-dashboard-public-service.onrender.com
DASHBOARD_PUBLIC_URL=https://your-dashboard-public-service.onrender.com

# Optional Service 1 external URL used in alerts/links
RENDER_EXTERNAL_URL=https://your-main-bot-service.onrender.com

# Optional owner/master Discord user ID. If unset, config.json ownerId is used.
SHADOW_MASTER_ID=replace-with-owner-discord-user-id

# Optional Discord webhook URLs. Use real values only in the host environment.
WEBHOOK_LOG_URL=https://discord-webhook-placeholder.invalid/logs
ALERT_WEBHOOK_URL=https://discord-webhook-placeholder.invalid/alerts

# Optional debug flag for multi-client voice behavior
VOICE_DEBUG_MULTI_CLIENT=false

# =========================================================
# Service 2 - Dashboard Public / Verification Dashboard
# Root directory: dashboard-public
# Start command: npm start
# =========================================================

# Required Discord OAuth2 application values
DISCORD_CLIENT_ID=replace-with-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-application-client-secret

# Required Express session secret
SESSION_SECRET=replace-with-random-session-secret

# Default false. Keep false unless OAuth token storage is explicitly approved.
STORE_OAUTH_TOKENS=false

# Render is behind a trusted proxy. For other hosts, enable only when you trust it.
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Default false. Enable only when the app is behind trusted Cloudflare forwarding.
ENABLE_CF_IP_HEADER=false

# =========================================================
# Discord Developer Portal Redirect URIs for Service 2
# =========================================================
# https://your-dashboard-public-service.onrender.com/auth/callback
# https://your-dashboard-public-service.onrender.com/auth/admin-callback
