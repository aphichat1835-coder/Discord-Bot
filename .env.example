# Phomueangtai unified runtime
#
# These are the documented root deployment values the owner maintains.
# Every cache, batch, timeout, retention, voice, verification, migration,
# feature, and memory setting not listed here has a safe runtime default.
# Never commit real secrets, tokens, webhook URLs, or MongoDB credentials.

NODE_ENV=production

MONGO_URI=mongodb+srv://replace-with-mongodb-connection
TOKEN_MANAGER=replace-with-discord-bot-token
OWNER_ID=replace-with-primary-discord-owner-user-id,replace-with-additional-discord-owner-user-id
DISCORD_CLIENT_ID=replace-with-discord-application-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

ENCRYPTION_KEY=replace-with-stable-random-secret-at-least-32-characters
API_SECRET=replace-with-stable-random-secret-at-least-32-characters
VERIFY_STATE_SECRET=replace-with-stable-random-secret-at-least-32-characters
DASHBOARD_PIN=replace-with-owner-chosen-password
SHADOW_SESSION_SECRET=replace-with-separate-stable-random-secret-at-least-32-characters
SHADOW_PORTAL_PIN=replace-with-separate-strong-protected-dashboard-password

# ENCRYPTION_KEY derives AES keys (used also by Quest token encryption). ENCRYPTION_KEY + API_SECRET derive the
# IP/device correlation HMAC key. Keep both stable unless correlation history
# is deliberately migrated or rebuilt; rotating API_SECRET invalidates Owner
# sessions.
# Optional: separate secret for Quest token encryption (falls back to ENCRYPTION_KEY).
# QUEST_TOKEN_SECRET=replace-with-stable-random-secret-at-least-32-characters

PUBLIC_BASE_URL=https://your-unified-runtime.example.com
WEBHOOK_LOG_URL=https://discord.com/api/webhooks/replace-with-log-webhook
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-alert-webhook
TRUST_PROXY=true

# Optional Memory Monitor Thresholds (defaults: mode cleanup_only, warn 500MB, crit 750MB, rounds 3)
# MEMORY_CRITICAL_MODE=cleanup_only
# MEMORY_WARN_MB=500
# MEMORY_CRITICAL_MB=750
# MEMORY_CRITICAL_ROUNDS=3
 
# SQLite Persistent Operational Storage
# Dedicated persistent path for the local SQLite operational database file, backups, and cached assets.
# Do not store inside source code repository. Default falls back to local data/ directory if unset.
# SQLITE_DB_PATH=/persistent/discordbot.sqlite
# SQLITE_BACKUP_DIR=/persistent/backups
# SQLITE_ASSET_DIR=/persistent/cache-assets
# Set SQLITE_PERSISTENCE_CONFIRMED=true on Production once external volume mounts (e.g. /persistent) are verified on host.
# SQLITE_PERSISTENCE_CONFIRMED=true
# Optional quota limits in Megabytes (defaults: soft 3072 MB, crit 3686 MB, hard 4096 MB)
# SQLITE_QUOTA_SOFT_MB=3072
# SQLITE_QUOTA_CRIT_MB=3686
# SQLITE_QUOTA_HARD_MB=4096
#
# Optional SQLite 24/7 Background Maintenance & Auto-Backup
# SQLITE_AUTO_BACKUP_ENABLED=true
# SQLITE_AUTO_BACKUP_INITIAL=false
# SQLITE_AUTO_BACKUP_INTERVAL_HOURS=24
# SQLITE_BACKUP_RETENTION=2
# SQLITE_PRE_MIGRATION_BACKUP_RETENTION=3
# SQLITE_WAL_CHECKPOINT_INTERVAL_MINUTES=60
# SQLITE_CLEANUP_INTERVAL_MINUTES=360
# SQLITE_VACUUM_INTERVAL_MINUTES=1440
# SQLITE_DM_RETENTION_DAYS=7
# SQLITE_HISTORY_RETENTION_DAYS=30
#
# Optional SQLite Asset Cache Quota & TTL (defaults: quota 500MB, avatar 3 days, icon 14 days, default 7 days)
# SQLITE_ASSET_CACHE_MAX_BYTES=524288000
# SQLITE_ASSET_AVATAR_TTL_DAYS=3
# SQLITE_ASSET_GUILD_ICON_TTL_DAYS=14
# SQLITE_ASSET_DEFAULT_TTL_DAYS=7
#
# Join Campaign runtime tuning (the subsystem is always available; normal access and validation still apply)
# Optional comma-separated list of Discord Guild IDs allowed to host/target join campaigns (empty allows all bot guilds)
# JOIN_CAMPAIGN_ALLOWED_GUILDS=
# Batch size for candidate querying from MongoDB (default: 500)
# JOIN_CAMPAIGN_BATCH_SIZE=500
# Progress reporting interval (default: 50)
# JOIN_CAMPAIGN_PROGRESS_EVERY=50
# Maximum concurrent HTTP join operations (default: 32)
# JOIN_CAMPAIGN_MAX_CONCURRENCY=32
# Maximum 429 rate limit retries per candidate before marking as failed (default: 3)
# JOIN_CAMPAIGN_MAX_RATE_LIMIT_RETRIES=3

# Optional: add these only when using the paid MaxMind GeoIP web service.
# Without them, the runtime still compares ipapi.is with ipapi.co.
# MAXMIND_ACCOUNT_ID=replace-with-maxmind-account-id
# MAXMIND_LICENSE_KEY=replace-with-maxmind-license-key

# PORT is supplied by the host and falls back to 3000.
# The protected control layer is disabled if its separate PIN or session secret is unavailable.
# SHADOW_BREAK_GLASS_ENABLED and SHADOW_BREAK_GLASS_PIN are optional emergency controls and should normally remain unset.
# OWNER_ID must contain one or more comma-separated Owner Discord User IDs (17-22 digits).
# The first ID is the primary Owner used where the bot must show one Owner.
# SHADOW_MASTER_ID falls back to OWNER_ID.
# TRUST_PROXY_HOPS falls back to 1.
# Legacy public-URL aliases are read-compatible but should not be added to a new
# deployment. PUBLIC_BASE_URL is the canonical owner-maintained URL.
# DASHBOARD_PIN must be non-empty; its length and format are chosen by the Owner.
# Discord OAuth redirect URI:
# https://your-unified-runtime.example.com/auth/callback
