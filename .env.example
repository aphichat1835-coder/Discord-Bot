# Phomueangtai unified runtime
#
# These are the only 13 deployment values the owner must maintain.
# Every cache, batch, timeout, retention, voice, audit, verification, migration,
# feature, and memory setting not listed here has a safe runtime default.
# Never commit real secrets, tokens, webhook URLs, or MongoDB credentials.

NODE_ENV=production

MONGO_URI=mongodb+srv://replace-with-mongodb-connection
TOKEN_MANAGER=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-application-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

ENCRYPTION_KEY=replace-with-stable-random-secret-at-least-32-characters
API_SECRET=replace-with-stable-random-secret-at-least-32-characters
VERIFY_STATE_SECRET=replace-with-stable-random-secret-at-least-32-characters
DASHBOARD_PIN=replace-with-owner-pin-at-least-6-characters

PUBLIC_BASE_URL=https://your-unified-runtime.example.com
WEBHOOK_LOG_URL=https://discord.com/api/webhooks/replace-with-log-webhook
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/replace-with-alert-webhook
TRUST_PROXY=true

# PORT is supplied by the host and falls back to 3000.
# SHADOW_MASTER_ID falls back to the owner ID in discord/config.json.
# TRUST_PROXY_HOPS falls back to 1.
# Discord OAuth redirect URI:
# https://your-unified-runtime.example.com/auth/callback
