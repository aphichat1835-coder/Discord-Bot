# =========================================================
# Phomueangtai Enterprise Discord System — Environment Example
# =========================================================
# ไฟล์นี้เป็นตัวอย่างเท่านั้น ใช้ placeholder ปลอมทั้งหมด
# ให้ copy เฉพาะตัวแปรที่ต้องใช้ไปใส่ในแต่ละ Render service หรือ local .env
# ห้าม commit token จริง, password จริง, webhook URL จริง, database URL จริง หรือ secret จริง

# =========================================================
# Shared / ใช้ร่วมกันระหว่าง Service 1 และ Service 2
# =========================================================
# Required: runtime mode
NODE_ENV=production

# Required: MongoDB connection string แบบ placeholder ห้ามใส่ URL จริงในไฟล์นี้
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/phomueangtai

# Required: secret สำหรับ encryption/HMAC-related logic ควรยาว 32 bytes ขึ้นไป
ENCRYPTION_KEY=change-me-long-random-secret-32-bytes-or-more

# Required for Service 1 / internal API protection
API_SECRET=change-me-long-random-api-secret

# Recommended for Service 2 internal API protection
INTERNAL_API_SECRET=change-me-long-random-internal-api-secret

# Recommended: secret เฉพาะสำหรับ signed verification state
VERIFY_STATE_SECRET=change-me-long-random-verify-state-secret

# =========================================================
# Service 1 — Main Bot + Owner Dashboard
# Render root directory: repository root
# Build command: npm install
# Start command: npm start
# =========================================================
# Required: Discord bot token จาก Discord Developer Portal
TOKEN_MANAGER=YOUR_DISCORD_BOT_TOKEN

# Optional locally. Render จะ inject PORT ให้อัตโนมัติ
PORT=3000

# Optional/Required ตาม owner dashboard config
DASHBOARD_PIN=change-me-owner-dashboard-pin

# Important: URL ของ Service 2 / Dashboard Public
DASHBOARD_URL=https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com
PUBLIC_DASHBOARD_URL=https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com

# Optional: Discord webhook URLs แบบ placeholder เท่านั้น ห้ามใส่ URL จริงในไฟล์นี้
WEBHOOK_LOG_URL=https://discord.com/api/webhooks/FAKE/WEBHOOK_LOG
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/FAKE/ALERT_LOG

# Optional: owner/master Discord user ID
SHADOW_MASTER_ID=YOUR_OWNER_DISCORD_USER_ID

# Optional: URL ของ Service 1 บน Render
RENDER_EXTERNAL_URL=https://YOUR-MAIN-BOT-SERVICE.onrender.com

# =========================================================
# Service 2 — Dashboard Public / Verification Dashboard
# Render root directory: dashboard-public
# Build command: npm install
# Start command: npm start
# =========================================================
# Optional locally. Render จะ inject PORT ให้อัตโนมัติ
PORT=3001
PORT_DASHBOARD=3001

# Required: Discord OAuth2 Application values
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_CLIENT_SECRET

# Required: ต้องเป็น bot token เดียวกับ Service 1 หรือ token ที่มีสิทธิ์ให้ role ได้
TOKEN_MANAGER=YOUR_DISCORD_BOT_TOKEN

# Required: Express session secret
SESSION_SECRET=change-me-long-random-session-secret

# Required/Important: public URL ของ Service 2
DASHBOARD_URL=https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com
PUBLIC_DASHBOARD_URL=https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com

# Optional: default false เพื่อไม่เก็บ OAuth tokens ถ้าไม่จำเป็น
STORE_OAUTH_TOKENS=false

# Optional: default false. เปิด true เฉพาะเมื่อ dashboard อยู่หลัง reverse proxy ที่เชื่อถือได้จริง
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Optional: default false. เปิด true เฉพาะเมื่อ deploy หลัง Cloudflare ที่เชื่อถือได้จริง
ENABLE_CF_IP_HEADER=false

# =========================================================
# Optional / needs confirmation for future risk providers
# ใส่เฉพาะถ้าโค้ดรองรับและเจ้าของโปรเจกต์อนุมัติแล้ว
# =========================================================
# PROXYCHECK_API_KEY=YOUR_FAKE_PROXYCHECK_KEY
# IPINFO_TOKEN=YOUR_FAKE_IPINFO_TOKEN

# =========================================================
# Discord Developer Portal OAuth2 Redirect URIs required for Service 2
# ต้องตั้งใน Discord Developer Portal ให้ตรงกับ URL จริง
# =========================================================
# https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com/auth/callback
# https://YOUR-DASHBOARD-PUBLIC-SERVICE.onrender.com/auth/admin-callback
