{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-contract",
  "type": "object",
  "required": ["version", "profile", "request", "risk", "invariants", "scenarios", "boundaries", "live_boundary", "status"],
  "properties": {
    "version": {"const": 1},
    "profile": {"type": "string"},
    "request": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "invariants": {"type": "array"},
    "scenarios": {"type": "array"},
    "boundaries": {"type": "array"},
    "live_boundary": {"type": "object"},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}
