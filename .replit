# Replit development configuration
# This file is only needed when opening/running the project in Replit.
# Production deployment uses Render settings and render.yaml instead.

modules = ["nodejs-18"]
entrypoint = "discord/index.js"
run = "npm start"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
