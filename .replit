modules = ["web", "nodejs-24"]
entrypoint = "discord/index.js"
run = "npm start"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:release"

[[workflows.workflow]]
name = "test-verification"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:verification"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "syntax-discord"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:all"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "syntax-scripts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:scripts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "memory-guards"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:memory-guards"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mongoose9-compat"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:mongoose9"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-discord"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "find discord/tests -name '*.test.js' ! -name 'voice*.test.js' -print0 | xargs -0 node --test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-voice"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --test discord/tests/voice*.test.js"

[workflows.workflow.metadata]
isValidation = true
