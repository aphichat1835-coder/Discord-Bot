{
  "name": "phomueangtai-enterprise",
  "version": "4.0.1",
  "description": "Phomueangtai personal multi-tool Discord bot and owner dashboard",
  "private": true,
  "main": "discord/index.js",
  "scripts": {
    "start": "node -r ./discord/core/loadEnv discord/index.js",
    "dev": "node -r ./discord/core/loadEnv discord/index.js",
    "check": "npm run check:all && npm run check:dashboard:all && npm run check:scripts && npm run check:memory-guards",
    "check:all": "find discord -type f -name '*.js' ! -name 'systemProvider.js' -print0 | xargs -0 -n1 node --check",
    "check:dashboard": "npm run check:dashboard:all",
    "check:dashboard:all": "cd dashboard-public && find . -path './node_modules' -prune -o -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:scripts": "find scripts -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:memory-guards": "node scripts/checkMemoryGuards.js",
    "check:memory-trend": "node scripts/checkMemoryTrend.js",
    "test": "npm run test:discord && npm run test:voice && npm --prefix dashboard-public test",
    "test:discord": "find discord/tests -name '*.test.js' ! -name 'voiceWorker*.test.js' -print0 | xargs -0 -r node --test",
    "test:voice": "node --test discord/tests/voiceWorker*.test.js",
    "dashboard:start": "npm --prefix dashboard-public start",
    "dashboard:dev": "npm --prefix dashboard-public run dev"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^13.17.1",
    "discord.js-selfbot-v13": "^3.7.1",
    "express": "^5.2.1",
    "libsodium-wrappers": "^0.8.4",
    "mongoose": "^8.24.1",
    "opusscript": "^0.1.1",
    "tweetnacl": "^1.0.3"
  }
}
