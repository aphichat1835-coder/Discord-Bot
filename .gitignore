# =========================================================
# Phomueangtai Enterprise Discord System — .gitignore
# Never commit secrets, generated files, dependency folders, logs, or local caches.
# =========================================================

# -------------------------
# Environment / secrets
# -------------------------
.env
.env.*
!.env.example
*.env
*.local

# Secret/key material
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore
secrets/
secret/
credentials/
credential/
private/

# Tokens / local config dumps
*tokens*.json
*token*.json
*secret*.json
*credential*.json
*credentials*.json

# -------------------------
# Dependencies
# -------------------------
node_modules/
dashboard-public/node_modules/

# -------------------------
# Logs
# -------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Runtime / temp / cache
# -------------------------
tmp/
temp/
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/
.nyc_output/

# -------------------------
# Build output
# -------------------------
dist/
build/
out/

# -------------------------
# Database / local state / backups
# -------------------------
discord/database.json
*.json.tmp
*.json.bak
*.bak
*.backup
*.sqlite
*.sqlite3
*.db
*.dump

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Editor / IDE
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# Misc local artifacts
# -------------------------
*.pid
*.seed
*.tgz
