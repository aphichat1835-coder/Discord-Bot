# ════════════════════════════════════════════════════════
#  🛡️ ENTERPRISE SECURITY — .gitignore
#  ห้าม commit ไฟล์เหล่านี้ขึ้น GitHub เด็ดขาด
# ════════════════════════════════════════════════════════

# Environment Variables (ข้อมูลลับสุดยอด)
.env
.env.local
.env.production
.env.development

# Node Modules (ใหญ่เกินไป ไม่จำเป็นต้อง commit)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database JSON Fallback (ตัดตามเฟส 10)
discord/database.json
*.json.tmp
*.json.bak

# Log Files
logs/
*.log

# OS Files
.DS_Store
Thumbs.db

# Editor Files
.vscode/
.idea/
*.swp
*.swo

# Build Output
dist/
build/

# Temp Files
tmp/
temp/
